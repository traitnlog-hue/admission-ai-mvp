# 학생부 AI 분석을 연결할 때만 사용합니다. 키를 브라우저로 보내지 마세요.
OPENAI_API_KEY=

# 공식 입시 DB 업로드를 보호하는 관리자 토큰입니다. 배포 환경에서는 반드시 설정하세요.
ADMIN_API_TOKEN=

# 이메일 계정 비밀번호 해시에 추가하는 서버 전용 비밀값입니다.
GACHI_AUTH_PEPPER=

# PASS/NICE/KCB 등 계약 완료 후 서버가 발급한 본인확인 시작 URL입니다.
# 주민등록번호는 GACHI 앱이나 DB에 저장하지 않습니다.
IDENTITY_VERIFICATION_URL=
